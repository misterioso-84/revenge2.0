rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_state/{documentId} {
      allow read, write: if true;
    }
    match /app_tables/{documentId} {
      allow read, write: if true;
    }
    match /test_connectivity/{documentId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

