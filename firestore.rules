rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /app_tables/{document} {
      allow read, write: if true;
    }
    match /app_state/{document} {
      allow read, write: if true;
    }
  }
}
